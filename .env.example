# =============================================================================
# Variables lues par docker-compose.yml (stack MarsaBot en conteneurs)
# -----------------------------------------------------------------------------
# Copier ce fichier en .env À LA RACINE de MarsaBot_Factory :
#     cp .env.example .env
# puis renseigner JWT_SECRET, DEFAULT_ADMIN_PASSWORD et TAVILY_API_KEY.
#
# Ce fichier ne concerne QUE l'exécution via Docker Compose. Le mode natif
# (node src/index.js) utilise backend/.env séparément.
# =============================================================================

# Base de données
DB_NAME=marsabot_db
DB_USER=marsabot
DB_PASSWORD=change_me_db_password

# Sécurité JWT (secret long et aléatoire). Générer par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin par défaut, créé via GET /api/admin/setup
DEFAULT_ADMIN_EMAIL=admin@marsamaroc.ma
DEFAULT_ADMIN_PASSWORD=change_me_admin_password

# Clé Tavily (recherche web des bots) — https://app.tavily.com/
# Optionnelle : sans elle, la recherche web est simplement désactivée.
TAVILY_API_KEY=

# URL d'Ollama. En conteneur, le backend joint l'Ollama de l'hôte via
# host.docker.internal (les modèles llama3.2 et nomic-embed-text doivent y être).
OLLAMA_URL=http://host.docker.internal:11434

# Origines autorisees a appeler l'API depuis un navigateur (CORS), separees par
# des virgules. Sans cette variable, seules les origines locales de
# developpement sont acceptees : localhost et 127.0.0.1 sur 5173 et 5174.
# Une origine absente de la liste est refusee, jamais tout autorise.
# En conteneur, le frontend est servi par Nginx sur le port 80 : penser a
# declarer son origine ici, par exemple http://localhost
CORS_ORIGINS=

# Limitation des tentatives de connexion (POST /api/admin/login).
# Defauts : 20 tentatives par tranche de 15 minutes et par adresse.
# Mettre LOGIN_RATE_LIMIT_MAX=0 desactive completement la limitation.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# Hotes internes autorises comme sources API (SSRF).
# Par defaut, toute adresse privee, localhost ou lien-local est refusee.
# Lister ici les exceptions, separees par des virgules, avec le port.
# Exemple pour interroger MarsaTrack AI :  localhost:3001,127.0.0.1:3001
# Sur le reseau partage marsa_net, l'hote est le nom du conteneur MarsaTrack.
ALLOWED_INTERNAL_HOSTS=

# Point d'integration MarsaTrack AI. PAS ENCORE LUE PAR LE CODE : les URL de
# sources API sont aujourd'hui saisies entieres dans l'interface, jeton compris.
# Cette variable est declaree pour la fusion a venir des deux services, ou la
# base d'URL sera configuree une fois cote serveur au lieu d'etre ressaisie.
# Exemple sur marsa_net :  http://marsatrack-backend:3001
MARSATRACK_BASE_URL=
