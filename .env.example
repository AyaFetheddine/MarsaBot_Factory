# =============================================================================
# Variables lues par docker-compose.yml (stack MarsaBot en conteneurs)
# -----------------------------------------------------------------------------
# Copier ce fichier en .env À LA RACINE de MarsaBot_Factory :
#     cp .env.example .env
# puis renseigner JWT_SECRET, DEFAULT_ADMIN_PASSWORD et TAVILY_API_KEY.
#
# Ce fichier ne concerne QUE l'exécution via Docker Compose. Le mode natif
# (node src/index.js) utilise backend/.env séparément.
# =============================================================================

# Base de données
DB_NAME=marsabot_db
DB_USER=marsabot
DB_PASSWORD=change_me_db_password

# Sécurité JWT (secret long et aléatoire). Générer par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin par défaut, créé via GET /api/admin/setup
DEFAULT_ADMIN_EMAIL=admin@marsamaroc.ma
DEFAULT_ADMIN_PASSWORD=change_me_admin_password

# Clé Tavily (recherche web des bots) — https://app.tavily.com/
# Optionnelle : sans elle, la recherche web est simplement désactivée.
TAVILY_API_KEY=

# URL d'Ollama. En conteneur, le backend joint l'Ollama de l'hôte via
# host.docker.internal (les modèles llama3.2 et nomic-embed-text doivent y être).
OLLAMA_URL=http://host.docker.internal:11434
