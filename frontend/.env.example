# =============================================================================
# Variables du frontend MarsaBot. Copier en .env dans frontend/ :
#     cp .env.example .env
#
# Vite n'expose au code que les variables prefixees VITE_, et leur valeur est
# figee dans le bundle au moment du build : changer d'API impose de relancer
# npm run build.
# =============================================================================

# URL de base de l'API backend, chemin /api compris.
# Sans elle, le code retombe sur http://localhost:3000/api.
VITE_API_URL=http://localhost:3000/api

# Port du serveur de developpement Vite. MarsaBot occupe 5174 et laisse 5173 a
# MarsaTrack, pour que les deux frontends puissent tourner en meme temps.
# Ce port doit figurer dans le CORS_ORIGINS du backend.
FRONTEND_PORT=5174
