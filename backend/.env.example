# Configuration Base de données
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=marsabot_db

# Sécurité API
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
DEFAULT_ADMIN_EMAIL=admin@marsamaroc.ma
DEFAULT_ADMIN_PASSWORD=change_this_admin_password_immediately

# Configuration Serveur
PORT=3000

# Ollama (LLM local)
OLLAMA_URL=http://localhost:11434

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Origines autorisees a appeler l API depuis un navigateur (CORS), separees
# par des virgules. Sans cette variable, seules les origines locales de
# developpement sont acceptees : localhost et 127.0.0.1 sur 5173 et 5174.
# Une origine absente de la liste est refusee, jamais tout autorise.
# Exemple en production :  https://marsabot.exemple.ma
CORS_ORIGINS=

# Limitation des tentatives de connexion (POST /api/admin/login).
# Defauts : 20 tentatives par tranche de 15 minutes et par adresse.
# Mettre LOGIN_RATE_LIMIT_MAX=0 desactive completement la limitation.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# Hotes internes autorises comme sources API (SSRF).
# Par defaut, toute adresse privee, localhost ou lien-local est refusee.
# Lister ici les exceptions, separees par des virgules, avec le port.
# Exemple pour interroger MarsaTrack AI :  localhost:3001,127.0.0.1:3001
ALLOWED_INTERNAL_HOSTS=

# Point d'integration MarsaTrack AI. PAS ENCORE LUE PAR LE CODE : les URL de
# sources API sont aujourd'hui saisies entieres dans l'interface, jeton compris.
# Declaree pour la fusion a venir des deux services, ou la base d'URL sera
# configuree une fois cote serveur au lieu d'etre ressaisie a chaque source.
# Exemple :  http://localhost:3001
MARSATRACK_BASE_URL=
